# Which set of site copy renders.
#
#   rewrite  the 2026 content rewrite (default when this is unset)
#   legacy   the original wording as imported from the old ringindia.net
#
# Both sets ship in the repo and cover every page, so switching is this one
# value plus a rebuild — no code change and no git revert. Any other value
# fails the build rather than silently serving the wrong copy.
#
# On Vercel: Project → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_CONTENT_VERSION=rewrite
